{
  "name": "visifold-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @visifold/web dev",
    "dev:thermal-cones": "pnpm research:stage:thermal-cones && pnpm dev",
    "build": "pnpm --filter @visifold/web build",
    "build:thermal-cones": "pnpm research:stage:thermal-cones && pnpm build",
    "lint": "eslint apps packages scripts",
    "typecheck": "tsc --project tsconfig.scripts.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run scripts && pnpm -r --if-present test",
    "research:stage:thermal-cones": "tsx scripts/stage-thermal-cones.ts",
    "data:snapshot:thermal-cones": "tsx scripts/snapshot-thermal-cones.ts"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
